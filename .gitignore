# Laravel-specific ignores
vendor/
composer.lock
.env
.env.local
.env.*
!.env.example

# Build and cache directories
bootstrap/cache/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
storage/logs/*.log

# Compiled files
*.php~
*.bak
*.orig

# Package manager
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*